# Hospital Management System - Environment Configuration Template
# In Render Web Service, configure these under Dashboard -> Service -> Environment.

# Flask secret key for signing session cookies (Required for production)
SECRET_KEY=

# Administrative authentication credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_in_production

# PostgreSQL Connection URL (Required on Render Free to prevent data loss)
# Supports Neon (neon.tech), Supabase (supabase.com), or Render PostgreSQL.
# Leave blank to use local SQLite (hospital.db) for development.
# Example: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: Custom SQLite database file path (used only when DATABASE_URL is not set)
# DATABASE_PATH=hospital.db

# Optional: Server port (Render sets this dynamically via PORT environment variable)
# PORT=5000
